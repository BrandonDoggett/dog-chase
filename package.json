{
  "name": "dog_game",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "store": "node scripts/store-assets.mjs",
    "deploy:lambda": "npm test && node scripts/deploy-lambda.mjs",
    "cap": "cap",
    "android:assets": "npx --yes @capacitor/assets@3.0.5 generate --android --assetPath assets",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android.mjs bundleRelease",
    "android:smoke": "node scripts/android-smoke.mjs"
  },
